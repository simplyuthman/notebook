# ==============================================================================
# NotesBook - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit your `.env` file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & GENERAL
# ------------------------------------------------------------------------------
# NODE_ENV=development

# Server-side base URL (used for payment redirect URLs, callbacks, webhook verification)
# APP_BASE_URL="http://localhost:3000"

# Public URL accessible from client browser (used for client redirects and metadata)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notesbook?schema=public"

# ------------------------------------------------------------------------------
# 3. BACKGROUND WORKER & QUEUE (Redis / BullMQ)
# ------------------------------------------------------------------------------
# Redis connection URL for worker pipeline (TRANSCRIBE, STRUCTURE, EXPORT jobs)
# REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (Cloudflare R2 / S3-compatible)
# ------------------------------------------------------------------------------
# Cloudflare R2 is the default storage provider for note images and exported PDFs.
# In local development, if unset, fallback local disk storage is used in .uploads/
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_BUCKET="notesbook-storage"

# ------------------------------------------------------------------------------
# 5. AI SERVICES (Vision OCR & Book Structuring)
# ------------------------------------------------------------------------------
# Google Gemini API key: Used for Stage 1-4 handwritten note vision OCR & transcription
# GEMINI_API_KEY="your_gemini_api_key"

# DeepSeek API key: Used for Stage 5-6 chapter organization and semantic structuring
# DEEPSEEK_API_KEY="your_deepseek_api_key"

# ------------------------------------------------------------------------------
# 6. PAYMENTS & BILLING (Flutterwave - NGN / Kobo)
# ------------------------------------------------------------------------------
# Flutterwave secret key for creating payments, subscriptions, and verifying transactions
# Use `FLWSECK_TEST-...` for test environment, `FLWSECK-...` for live production
# FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-your_flutterwave_secret_key"

# Flutterwave Webhook Secret Hash configured in your Flutterwave dashboard:
# Settings -> Webhooks -> Secret Hash (Used to verify `verif-hash` header on webhooks)
# FLUTTERWAVE_WEBHOOK_SECRET="your_flutterwave_webhook_secret_hash"

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE (Transactional SMTP)
# ------------------------------------------------------------------------------
# Used for sending email verification tokens and password reset links
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your_smtp_username"
# SMTP_PASS="your_smtp_password"
# SMTP_FROM="NotesBook <noreply@notesbook.app>"
